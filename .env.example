# Copy this file to .env and edit it. Never commit .env.

# development or production
NODE_ENV=production

# Public address of the site, exactly as visitors type it (used for sitemap.xml and origin checks)
SITE_URL=https://your-domain.example

# Where the server listens. Use 127.0.0.1 behind a reverse proxy.
HOST=127.0.0.1
PORT=3000

# Set to 1 when the site is behind one reverse proxy or CDN (Nginx, Caddy, Cloudflare).
# Leave empty when visitors connect straight to Node.
TRUST_PROXY=1

# Optional: where the SQLite database file lives (keep it outside the public folder)
# DB_PATH=/var/lib/cs2-guide/guide.db

# Optional: contact for security reports. Publishes /.well-known/security.txt when set.
# SECURITY_CONTACT=mailto:security@your-domain.example
