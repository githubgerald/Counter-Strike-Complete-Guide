<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= site.description %>">
  <meta name="theme-color" content="#f3f2ee">
  <title><%= site.title %></title>
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script type="module" src="/js/main.js"></script>
</head>
<body>
  <%- include('partials/sidebar') %>
  <main id="content">
    <div class="page" id="top">
      <header class="hero">
        <p class="eyebrow">COUNTER-STRIKE 2</p>
        <h1><%= site.title %></h1>
        <p class="hero-copy"><%= site.tagline %></p>
      </header>
      <% categories.forEach((category) => { %><%- include('partials/category', { category }) %><% }) %>
      <%- include('partials/resources') %>
      <%- include('partials/bibliography') %>
    </div>
  </main>
  <%- include('partials/book') %>
  <%- include('partials/settings') %>
  <div id="tooltip" role="tooltip" hidden></div>
  <div id="toast" role="status" aria-live="polite" hidden></div>
</body>
</html>
