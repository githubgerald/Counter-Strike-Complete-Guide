<div id="settings" class="modal" hidden>
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="settings-title" tabindex="-1">
    <aside class="modal-nav">
      <p class="modal-heading" id="settings-title">Settings</p>
      <button class="modal-tab is-active" type="button" data-tab="general">General</button>
      <button class="modal-tab" type="button" data-tab="account">Account</button>
    </aside>

    <div class="modal-body">
      <button id="settings-close" class="icon-btn modal-close" type="button" aria-label="Close settings">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>

      <section class="settings-panel" data-panel="general">
        <h2>General</h2>
        <p class="settings-lead">Control how the guide looks and works.</p>

        <div class="setting-row">
          <div><h3>Appearance</h3><p>Choose a light or dark reading theme.</p></div>
          <select id="theme-select" aria-label="Appearance">
            <option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option>
          </select>
        </div>
        <div class="setting-row">
          <div><h3>Guide mode</h3><p>Guided includes the try-it checklists and quizzes. Reference keeps the reading view clear.</p></div>
          <select id="mode-select" aria-label="Guide mode">
            <option value="guided">Guided</option><option value="reference">Reference</option>
          </select>
        </div>
        <div class="setting-row">
          <div><h3>Reading size</h3><p>Adjust the main text size.</p></div>
          <select id="size-select" aria-label="Reading size">
            <option value="small">Small</option><option value="medium">Medium</option><option value="large">Large</option>
          </select>
        </div>
        <div class="setting-row setting-row-stack">
          <div><h3>Cookies and local storage</h3><p>This guide does not set cookies or use an analytics tracker. Your theme, local profile and section progress are stored in this browser’s local storage and are not sent to an account.</p></div>
          <button id="clear-data" class="btn btn-subtle" type="button">Clear local data</button>
        </div>
        <div class="setting-row">
          <div><h3>Reset progress</h3><p>Clear completed modules but keep your appearance and profile settings.</p></div>
          <button id="reset-progress" class="btn btn-subtle" type="button">Reset progress</button>
        </div>
      </section>

      <section class="settings-panel" data-panel="account" hidden>
        <h2>Account</h2>
        <p class="settings-lead">This project has no online sign-in. Your profile is local to this browser.</p>
        <div class="setting-row">
          <div><h3>Display name</h3><p>Optional label stored on this device only.</p></div>
          <input id="name-input" type="text" maxlength="30" autocomplete="off" placeholder="Display name">
        </div>
        <div class="setting-row setting-row-stack">
          <div><h3>Progress backup</h3><p>Export your completed sections to a JSON file, or import a backup from another device.</p></div>
          <div class="button-pair">
            <button id="export-progress" class="btn btn-subtle" type="button">Export</button>
            <button id="import-progress" class="btn btn-subtle" type="button">Import</button>
            <input id="import-file" type="file" accept="application/json,.json" hidden>
          </div>
        </div>
        <p id="settings-message" class="settings-message" aria-live="polite"></p>
      </section>
    </div>
  </div>
</div>
